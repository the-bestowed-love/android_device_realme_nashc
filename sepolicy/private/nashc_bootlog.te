type nashc_bootlog, domain, coredomain;
type nashc_bootlog_exec, exec_type, system_file_type, file_type;
type nashc_bootlog_metadata_file, file_type;
init_daemon_domain(nashc_bootlog)

userdebug_or_eng(`
  allow init nashc_bootlog_metadata_file:dir create_dir_perms;
  allow nashc_bootlog kmsg_device:chr_file r_file_perms;
  allow nashc_bootlog self:global_capability2_class_set syslog;
  allow nashc_bootlog kernel:system syslog_read;
  allow nashc_bootlog nashc_bootlog_metadata_file:dir rw_dir_perms;
  allow nashc_bootlog nashc_bootlog_metadata_file:file create_file_perms;
')

recovery_only(`
  allow recovery nashc_bootlog_metadata_file:dir r_dir_perms;
  allow recovery nashc_bootlog_metadata_file:file r_file_perms;
')
