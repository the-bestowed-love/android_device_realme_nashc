# BPF interfaces backported from the 5.10 networking ABI
ro.bpf.kver_override=5.10.239

# HWUI
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false

# IMS
persist.dbg.volte_avail_ovr=1
persist.dbg.wfc_avail_ovr=0

# SystemUI
persist.sysui.disableBlur=true

# Zygote
zygote.critical_window.minute=10
ro.zygote.disable_app_zygote=true
